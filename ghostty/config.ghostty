# Ghostty config — ported from iTerm2 profile "No Tmux"
# (iTerm2 3.6.11, default bookmark 1747A7A7-EBAC-4929-B665-FD3722B7EC15)

# ── Font ────────────────────────────────────────────────────────────────
# iTerm: Normal Font = MesloLGMNFM-Regular 14
# Size deliberately bumped — the iTerm value was 14.
font-family = MesloLGM Nerd Font Mono
font-size = 15

# Hangul fallback, two faces deep. Meslo has no Hangul glyphs at all, and
# Ghostty's automatic fallback picks PCMyungjo (a serif 명조 face).
#
# 1) D2Coding takes precomposed syllables (U+AC00-D7A3), compatibility jamo
#    (U+3130-318F), and — as a side effect of being first — hanja and kana.
#    A terminal treats all of these as East Asian Wide and gives them exactly
#    two cells, i.e. 2 x 0.6021em = 1.2042em of Meslo, so what decides whether
#    a face lands on the grid is its own Hangul-to-Latin advance ratio.
#    Measured with CoreText at 100pt:
#      D2Coding             A=50.00  한=100.00  -> exactly 2.00
#      Apple SD Gothic Neo  A=60.50  한= 86.50  -> 1.43
#    Apple SD Gothic Neo is a proportional UI face; its Hangul is only 1.43x its
#    own Latin, so putting it on a two-cell grid means stretching it ~40%.
#    D2Coding is drawn 2:1 to begin with, so a uniform scale lands it exactly.
#
# 2) Apple SD Gothic Neo stays behind it for conjoining jamo (U+1100-11FF),
#    which D2Coding does not cover (measured: those codepoints fall through to
#    PCMyungjo). macOS stores filenames decomposed, so without this line every
#    Korean filename in `ls` scatters into serif standalone jamo.
#
# Repeated font-family entries are tried front to back, so this order is the
# priority order. Apple SD Gothic Neo ships with macOS; D2Coding does not --
# `brew install --cask font-d2coding` (./install checks for it and says so).
#
# (The iTerm profile named NanumGothic as its non-ASCII font, but that font
# isn't installed and "Use Non-ASCII Font" was off, so it was never used.)
font-family = D2Coding
font-family = Apple SD Gothic Neo

# iTerm: ASCII/Non-ASCII Ligatures = off
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# iTerm: Use Bright Bold = on (bold text uses the bright palette)
bold-color = bright

# ── Colors ──────────────────────────────────────────────────────────────
# Deliberately NOT the iTerm profile's colors. Despite the name, "Solarized
# Osaka Night" is a Tokyo Night palette (background #1a1b26, foreground
# #c0caf5) and shares nothing with Solarized.
#
# The faithful port is `theme = iTerm2 Solarized Dark`, which matches the
# iTerm profile's 22 colors except palette 8 (bright black): iTerm set it to
# #002b36, the same as the background, making bright/bold black text
# invisible. That theme uses #335e69 instead.
theme = Solarized Osaka Night

# ── Cursor ──────────────────────────────────────────────────────────────
# iTerm: box cursor, Blinking Cursor = off
cursor-style = block
cursor-style-blink = false

# ── Window ──────────────────────────────────────────────────────────────
# iTerm: Columns = 80, Rows = 25
window-width = 80
window-height = 25

# iTerm: Transparency = 0, Blur = off
background-opacity = 1
background-blur = false

# iTerm: Dim inactive split panes = on, dimming amount ~0.05
unfocused-split-opacity = 0.95

# iTerm had this off (Prompt Before Closing = off, PromptOnQuit = off), but the
# default is kept on purpose. herdr's server is a child of the terminal
# (Ghostty -> login -> zsh -> herdr -> herdr server), so one stray cmd+w or
# cmd+q takes down every agent running in it, silently, with `false`.
confirm-close-surface = true

# iTerm: Custom Directory = No (start in home)
working-directory = home

# iTerm tab style was "Minimal"; closest Ghostty equivalent is the integrated
# tab bar. Uncomment if you want it instead of the default transparent titlebar.
# macos-titlebar-style = tabs

# ── Keyboard ────────────────────────────────────────────────────────────
# iTerm: Left/Right Option Key Sends = Esc+
macos-option-as-alt = true

# iTerm's default tab navigation. Ghostty ships tab navigation on cmd+shift+[ /
# cmd+shift+] (and ctrl+tab) but nothing on cmd+arrows, so add the arrow
# bindings. Note what this costs: cmd+arrow_left/right are not free in Ghostty,
# they default to `text:\x01` / `text:\x05` (Ctrl-A / Ctrl-E, start/end of
# line). Comment these two out if you want that back.
keybind = cmd+arrow_left=previous_tab
keybind = cmd+arrow_right=next_tab

# iTerm remapped ctrl+opt+arrows to CSI 1;7{A,B,C,D}. Ghostty already emits
# these sequences natively, so no keybind is needed. Uncomment only if some
# app disagrees (note: this forces the legacy encoding even under the Kitty
# keyboard protocol).
# keybind = ctrl+alt+up=csi:1;7A
# keybind = ctrl+alt+down=csi:1;7B
# keybind = ctrl+alt+left=csi:1;7D
# keybind = ctrl+alt+right=csi:1;7C

# ── ssh ─────────────────────────────────────────────────────────────────
# iTerm reported TERM=xterm-256color; Ghostty's default is xterm-ghostty, which
# no remote host has terminfo for, so `ssh somewhere` lands in a session with a
# broken terminal. `ssh-env` converts TERM back to xterm-256color for ssh and
# propagates COLORTERM/TERM_PROGRAM instead.
#
# The alternative, `ssh-terminfo`, keeps xterm-ghostty by installing Ghostty's
# terminfo into the remote's ~/.terminfo on first connect. That writes to every
# host you ssh into, so it stays off here; add it if you want the full feature
# set on hosts you own. Unlisted features keep their defaults.
shell-integration-features = ssh-env

# ── Bell ────────────────────────────────────────────────────────────────
# iTerm: audible bell on, visual bell on, notification on bell
bell-features = system,attention,title,border

# ── Clipboard ───────────────────────────────────────────────────────────
# Nothing to set. iTerm's AllowClipboardAccess = on lets programs WRITE the
# clipboard (OSC 52 copy), which Ghostty already allows by default
# (clipboard-write = allow). Reading is a separate permission Ghostty gates
# behind a prompt (clipboard-read = ask) and iTerm never granted at all, so
# setting it to `allow` would hand every program -- including one on the far
# end of an ssh session -- silent access to whatever is on the clipboard.
# herdr only ever writes (OSC 52 `]52;c;<base64>`), so the default is enough.
