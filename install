#!/bin/bash

cur="$(cd "$(dirname "$0")" && pwd)"
install="$cur/script/install.sh"

# 의존성 확인
check_dependencies() {
  echo "의존성 확인 중..."
  for cmd in git nvim; do
    if ! command -v $cmd &> /dev/null; then
      echo "오류: $cmd가 설치되어 있지 않습니다."
      exit 1
    fi
  done
  echo "필수 의존성이 설치되어 있습니다."

  # zsh 설정이 참조하지만 없어도 설치는 진행되는 도구들.
  # (( $+commands[...] )) 가드로 감싸 두었기 때문에 없으면 해당 기능만 조용히
  # 빠진다. 조용히 빠지는 것이 문제라서 여기서 알려 준다.
  local -a missing=()
  local cmd pkg
  for pkg in \
    "zoxide:zoxide:디렉토리 점프 (z, zi, j)" \
    "fzf:fzf:^R 히스토리 검색, ^T 파일 선택, alt+c cd"
  do
    cmd="${pkg%%:*}"
    if ! command -v "$cmd" &> /dev/null; then
      missing+=("$pkg")
    fi
  done

  if [ ${#missing[@]} -gt 0 ]; then
    echo
    echo "참고: 아래 도구가 없어 해당 기능은 비활성 상태로 설치됩니다."
    for pkg in "${missing[@]}"; do
      cmd="${pkg%%:*}"
      local rest="${pkg#*:}"
      printf "  %-9s (brew install %-16s) %s\n" "$cmd" "${rest%%:*}" "${rest#*:}"
    done
    echo
  fi
}

# 폰트 파일 존재 확인. 첫 인자는 폰트 디렉토리 안에서 찾을 파일명 글롭이다.
font_installed() {
  local pattern="$1" dir
  # 사용자 설치(brew --cask font-*)가 홈으로 가고, 나머지 둘은 수동 설치 경로다.
  for dir in "$HOME/Library/Fonts" "/Library/Fonts" "/System/Library/Fonts"; do
    [ -d "$dir" ] || continue
    if compgen -G "$dir/$pattern" > /dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

# 폰트 확인
#
# ghostty/config.ghostty가 이름으로 지정하는 폰트들이다. 없어도 Ghostty는 오류
# 없이 뜨고 조용히 다른 폰트로 폴백하므로(아이콘은 두부, 한글은 PCMyungjo 명조체)
# 증상만 보고는 원인을 알기 어렵다. 그래서 여기서 미리 알려 준다.
#
# 설치를 대신 해 주지는 않는다. brew가 없을 수 있고, 설치 스크립트가 임의로
# 네트워크에서 폰트를 받아 홈에 쓰는 것은 이 스크립트의 역할 밖이다.
check_fonts() {
  echo "폰트 확인 중..."
  local -a missing=()
  local entry pattern name rest

  # 글롭 : 폰트 이름 : cask 이름 : 설명
  for entry in \
    "MesloLGMNerdFontMono-*:Meslo LG Nerd Font:font-meslo-lg-nerd-font:기본 폰트, Nerd Font 아이콘" \
    "D2Coding*:D2Coding:font-d2coding:한글 폴백 (완성형 음절·호환 자모)"
  do
    pattern="${entry%%:*}"
    rest="${entry#*:}"
    if ! font_installed "$pattern"; then
      missing+=("$rest")
    fi
  done

  # 조합형 자모(U+1100-11FF) 폴백. macOS 기본 탑재라 없을 일이 사실상 없지만,
  # 이게 빠지면 NFD로 저장된 한글 파일명이 명조체 낱자로 흩어진다.
  if ! font_installed "AppleSDGothicNeo.ttc"; then
    echo "경고: Apple SD Gothic Neo가 없습니다. 한글 파일명(NFD 조합형 자모)이 깨져 보입니다."
  fi

  if [ ${#missing[@]} -eq 0 ]; then
    echo "필요한 폰트가 설치되어 있습니다."
    return 0
  fi

  echo
  echo "참고: 아래 폰트가 없어 Ghostty 표시가 깨질 수 있습니다."
  for entry in "${missing[@]}"; do
    name="${entry%%:*}"
    rest="${entry#*:}"
    printf "  %-18s (brew install --cask %-23s) %s\n" "$name" "${rest%%:*}" "${rest#*:}"
  done
  echo
}

# 백업 생성
#
# 이 함수가 실패하면 호출자는 설치를 진행하지 않는다. 백업은 아래 설치 단계가
# 홈의 파일을 지우기 전의 유일한 보호막이므로, 백업이 불완전한 상태로 파괴적
# 단계에 들어가면 되돌릴 방법이 없다.
create_backup() {
  echo "기존 설정 백업 중..."
  BACKUP_DIR="$HOME/.config/backup_$(date +%Y%m%d%H%M%S)"
  if ! mkdir -p "$BACKUP_DIR"; then
    echo "오류: 백업 디렉토리를 만들 수 없습니다: $BACKUP_DIR" >&2
    return 1
  fi

  # -r(대문자 -R 아님)은 의도적이다. macOS cp에서 -r은 심링크를 **역참조**하므로
  # (실측: -r -> 일반 파일, -R -> 심링크 유지) 두 번째 설치 이후에도 백업이
  # 링크 묶음이 아니라 그 시점 내용의 독립 사본이 된다. -R로 바꾸지 말 것.
  if [ -d "$HOME/.config/nvim" ]; then
    if ! cp -r "$HOME/.config/nvim" "$BACKUP_DIR/"; then
      echo "오류: Neovim 설정 백업에 실패했습니다: $HOME/.config/nvim" >&2
      echo "      (끊긴 심링크가 있으면 cp -r이 실패합니다. 확인 후 다시 실행하세요:" >&2
      echo "       find -L \"$HOME/.config/nvim\" -type l)" >&2
      return 1
    fi
  fi

  # zsh 설치 단계는 홈의 runcom 6개를 지우고 다시 링크한다. 심링크가 아니라
  # 로컬 수정이 담긴 실체 파일일 수 있으므로 -L로 역참조해 사본을 남긴다.
  mkdir -p "$BACKUP_DIR/zsh"
  for zf in .zshenv .zprofile .zshrc .zpreztorc .zlogin .zlogout; do
    [ -e "$HOME/$zf" ] || continue
    cp -L "$HOME/$zf" "$BACKUP_DIR/zsh/$zf" 2>/dev/null || cp "$HOME/$zf" "$BACKUP_DIR/zsh/$zf"
  done

  # herdr은 설정과 런타임 상태(session.json, 로그, 소켓)가 한 디렉토리에 섞여 있으므로
  # 설치가 덮어쓰는 config.toml만 백업한다.
  #
  # cp의 종료 상태를 반드시 검사한다. 검사하지 않으면 권한/디스크 문제로 사본을
  # 만들지 못해도 create_backup이 성공으로 끝나고, main_install이 같은 경로를
  # rm -rf 한다. 즉 유일한 복구 수단 없이 파괴적 단계로 들어간다.
  if [ -f "$HOME/.config/herdr/config.toml" ]; then
    if ! mkdir -p "$BACKUP_DIR/herdr" ||
       ! cp "$HOME/.config/herdr/config.toml" "$BACKUP_DIR/herdr/"; then
      echo "오류: herdr 설정 백업에 실패했습니다: $HOME/.config/herdr/config.toml" >&2
      return 1
    fi
  fi

  # Ghostty도 같은 이유로 설치가 덮어쓰는 파일 하나만 백업한다.
  if [ -f "$HOME/.config/ghostty/config.ghostty" ]; then
    if ! mkdir -p "$BACKUP_DIR/ghostty" ||
       ! cp "$HOME/.config/ghostty/config.ghostty" "$BACKUP_DIR/ghostty/"; then
      echo "오류: Ghostty 설정 백업에 실패했습니다: $HOME/.config/ghostty/config.ghostty" >&2
      return 1
    fi
  fi

  # main_install이 덮어쓰는 git 전역 설정의 이전 값을 남긴다.
  # 파일이 아니라 설정 값이라 백업 디렉토리에 저절로 담기지 않는다. 기록이 없으면
  # 다른 전역 ignore 파일을 쓰던 장비에서 이전 값을 되돌릴 방법이 없다.
  local prev_excludes
  prev_excludes="$(git config --global --get core.excludesfile 2>/dev/null)"
  if ! {
    echo "# ./install 실행 전 git 전역 설정 ($(date '+%Y-%m-%d %H:%M:%S'))"
    if [ -n "$prev_excludes" ]; then
      echo "core.excludesfile = $prev_excludes"
      echo "# 되돌리기: git config --global core.excludesfile '$prev_excludes'"
    else
      echo "core.excludesfile = (미설정)"
      echo "# 되돌리기: git config --global --unset core.excludesfile"
    fi
  } > "$BACKUP_DIR/git-config-before.txt"; then
    echo "오류: git 설정 백업을 쓸 수 없습니다: $BACKUP_DIR/git-config-before.txt" >&2
    return 1
  fi

  echo "백업 완료: $BACKUP_DIR"
}

# 메인 설치 과정
main_install() {
  echo "스크립트 설치 중..."
  (cd "$cur/script" && $install ~/bin) || exit 1

  echo "설정 파일 설치 중..."
  (cd "$cur/settings" && $install ~) || exit 1

  echo "Neovim 설정 설치 중..."
  (mkdir -p ~/.config/nvim)
  (cd "$cur/nvim" && $install ~/.config/nvim) || exit 1

  echo "zsh 설정 설치 중..."
  # prezto의 runcoms를 ~/.zprezto 클론 안에서 직접 고치면 prezto 업데이트 때
  # 충돌하거나 날아간다. 저장소가 원본을 갖고 홈으로 링크해, ~/.zprezto는
  # upstream 그대로 두고 언제든 git pull 할 수 있게 한다.
  # 비밀정보는 추적하지 않는 ~/.zshenv.local에 두고 zsh/.zshenv가 source 한다.
  (cd "$cur/zsh" && $install ~) || exit 1

  # fasd -> zoxide 히스토리 이관. 마커 파일로 한 번만 돌고, zoxide가 없거나
  # 이관할 DB가 없으면 스스로 건너뛴다. 실패해도 설치를 멈추지 않는다.
  if [ -x "$cur/script/zoxide-import-fasd.sh" ]; then
    echo "zoxide 히스토리 이관 확인 중..."
    "$cur/script/zoxide-import-fasd.sh" || true
  fi

  echo "herdr 설정 설치 중..."
  # ~/.config/herdr에는 herdr이 만드는 런타임 파일(session.json, *.log, *.sock)이 함께 있으므로
  # 디렉토리 전체가 아니라 herdr/ 안의 파일만 개별 심링크한다.
  mkdir -p ~/.config/herdr || return 1
  # 디렉토리 순회(=$install)를 쓰면 나중에 herdr/에 파일이 추가될 때 그것까지
  # ~/.config/herdr로 링크되어 동명 런타임 파일을 지운다. 대상을 고정한다.
  rm -rf ~/.config/herdr/config.toml
  if ! ln -s "$cur/herdr/config.toml" ~/.config/herdr/config.toml; then
    echo "오류: herdr 설정 링크를 만들 수 없습니다." >&2
    return 1
  fi
  if command -v herdr &> /dev/null; then
    herdr config check || echo "경고: herdr 설정 검증에 실패했습니다. herdr/config.toml을 확인하세요."
    # 서버가 떠 있으면 재시작 없이 반영 (떠 있지 않으면 실패해도 무방)
    herdr server reload-config &> /dev/null || true
  fi

  echo "Ghostty 설정 설치 중..."
  mkdir -p ~/.config/ghostty || return 1
  # herdr과 같은 이유로 디렉토리 순회($install)를 쓰지 않고 대상을 고정한다.
  # Ghostty 자체는 이 디렉토리에 아무것도 쓰지 않지만, 코딩 에이전트를
  # ~/.config/ghostty에서 실행하면 .claude 같은 상태 디렉토리가 생긴다.
  # 순회 설치는 저장소 쪽 ghostty/에 같은 이름이 생기는 순간 그것을 rm -rf 하고
  # 링크로 덮어쓴다. isIgnored는 .omo/.sisyphus만 걸러 .claude는 통과한다.
  rm -rf ~/.config/ghostty/config.ghostty
  if ! ln -s "$cur/ghostty/config.ghostty" ~/.config/ghostty/config.ghostty; then
    echo "오류: Ghostty 설정 링크를 만들 수 없습니다." >&2
    return 1
  fi
  # Ghostty는 같은 디렉토리의 config와 config.ghostty를 **둘 다** 읽는다(1.3.1 실측).
  # 확장자 없는 config가 남아 있으면 두 파일이 함께 로드되어(config -> config.ghostty
  # 순서라 겹치는 항목은 저장소 쪽이 이긴다) 저장소가 설정하지 않는 항목이 조용히
  # 남는다. 지우지는 않고 알려만 준다 — 저장소가 만든 파일이 아니다.
  if [ -e "$HOME/.config/ghostty/config" ]; then
    echo "경고: ~/.config/ghostty/config 가 함께 로드됩니다. 저장소가 관리하는 파일은"
    echo "      config.ghostty 하나입니다. 옮기거나 지우세요."
  fi

  # PATH에 없을 수 있다(Ghostty.app 안의 바이너리라 앱 셸 통합이 넣어 준다).
  # 없으면 검증 없이 넘어간다 — 설치를 막지는 않는다.
  if command -v ghostty &> /dev/null; then
    ghostty +validate-config || echo "경고: Ghostty 설정 검증에 실패했습니다. ghostty/config.ghostty를 확인하세요."
  fi

  echo "SBT 설정 설치 중..."
  mkdir -p ~/.sbt/1.0 || return 1
  for sbt_item in "$cur/sbt/1.0"/*; do
    [ -e "$sbt_item" ] || continue

    sbt_name="$(basename "$sbt_item")"
    if [ "$sbt_name" == "_recursive_" ]; then
      continue
    fi

    sbt_target="$HOME/.sbt/1.0/$sbt_name"
    if [ -L "$sbt_target" ] || [ -f "$sbt_target" ]; then
      rm -f "$sbt_target"
    elif [ -d "$sbt_target" ]; then
      rm -rf "$sbt_target"
    fi

    if ! cp -R "$sbt_item" "$sbt_target"; then
      echo "오류: SBT 설정 복사 실패: $sbt_item -> $sbt_target" >&2
      return 1
    fi
  done

  echo "Git 설정 적용 중..."
  # 이전 값은 create_backup이 $BACKUP_DIR/git-config-before.txt에 기록해 두었다.
  if ! git config --global core.excludesfile ~/.gitignore_global; then
    echo "오류: git 전역 설정을 적용할 수 없습니다." >&2
    return 1
  fi

  echo "Neovim 플러그인 설치 중..."
  # bang이 필수다. lazy.nvim은 `:Lazy`의 bang 여부만 wait로 넘기고
  # (view/commands.lua의 `wait = cmd.bang == true`) manage/init.lua는 opts.wait일 때만
  # 완료를 기다린다. bang 없이 부르면 곧바로 이어지는 qa가 동기화를 끊을 수 있다.
  if ! nvim --headless "+Lazy! sync" +qa; then
    echo "오류: Neovim 플러그인 동기화 실패. nvim을 열어 :Lazy로 상태를 확인하세요." >&2
    return 1
  fi
}

# 메인 함수
main() {
  check_dependencies
  check_fonts

  # 백업이 실패하면 파괴적 설치로 넘어가지 않는다.
  if ! create_backup; then
    echo >&2
    echo "백업에 실패해 설치를 중단했습니다. 홈의 설정은 그대로입니다." >&2
    exit 1
  fi

  # main_install의 상태를 반드시 검사한다.
  # 예전에는 검사하지 않고 곧바로 완료 메시지를 출력했고, 함수의 마지막 명령 뒤에
  # echo 두 개가 성공하므로 스크립트도 0으로 끝났다. 즉 herdr/SBT/Git/Lazy 단계가
  # 실패해도 "설치가 완료되었습니다!"가 나왔다.
  if ! main_install; then
    echo >&2
    echo "설치가 중간에 실패했습니다. 위 오류를 확인하세요." >&2
    echo "백업: $BACKUP_DIR" >&2
    exit 1
  fi

  echo "설치가 완료되었습니다!"
  echo "새 터미널을 열어 설정을 적용하세요."
}

# 실행
main
