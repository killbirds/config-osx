#!/bin/bash
#
# 현재 디렉토리 바로 아래의 git 저장소를 모두 순회하며 git pull 한다.

set -u

# 이전 버전은 PROJECTS=(`ls -la1`) 이었다. -l 때문에 drwxr-xr-x, 5, kino, staff,
# Aug 같은 필드가 전부 배열에 들어가고 파일명 필드만 우연히 살아남았으며,
# -a 때문에 '.'이 포함되어 현재 저장소 자신을 한 번 더 pull 했다.
# 글로브를 쓰면 디렉토리만, 숨김 항목과 '.' / '..' 없이 얻는다.
shopt -s nullglob

# 하나가 실패해도 나머지는 계속 받되, 종료 코드에는 반영한다.
# 예전에는 pull 실패가 무시되고 마지막 sleep이 성공하면 전체가 0으로 끝나,
# 자동화에서 이 스크립트로 갱신 성공 여부를 판단할 수 없었다.
status=0
failed=()

for PROJECT in */; do
  PROJECT="${PROJECT%/}"

  # 워크트리와 서브모듈에서 .git은 디렉토리가 아니라 파일이므로 -e로 검사한다.
  [ -e "$PROJECT/.git" ] || continue

  echo "current dir: $(cd "$PROJECT" && pwd)"
  if ! (cd "$PROJECT" && git pull --all --recurse-submodules --log); then
    status=1
    failed+=("$PROJECT")
    echo "  !! pull 실패: $PROJECT"
  fi
  echo "--------------------------------------"

  sleep 5
done

if (( ${#failed[@]} )); then
  echo
  echo "실패한 저장소 ${#failed[@]}개:"
  printf '  %s\n' "${failed[@]}"
fi

exit "$status"
